{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ticket-adapter/v1/error.json",
  "title": "Failure response",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "detail"],
          "properties": {
            "code": { "const": "conflict" },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "detail": { "type": "object", "required": ["current"], "properties": { "current": { "$ref": "ticket.json" } } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable", "detail"],
          "properties": {
            "code": { "const": "invalid" },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "detail": {
              "type": "object",
              "required": ["fields"],
              "properties": {
                "fields": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["field", "message"],
                    "properties": { "field": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": { "enum": ["unavailable", "timeout", "not_found", "denied", "unsupported", "incomplete", "internal"] },
            "message": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean" },
            "detail": { "type": "object" }
          }
        }
      ]
    }
  }
}
