{
  "name": "sign-off-axi",
  "version": "0.1.0",
  "description": "One local review board where you answer your agents' yes/no and pick-one questions: an AXI CLI agents run with no setup.",
  "type": "module",
  "bin": { "sign-off-axi": "dist/cli.js" },
  "files": ["dist", "!dist/skill.js", "web"],
  "engines": { "node": ">=22.5" },
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/umeranjum17/sign-off.git" },
  "keywords": ["axi", "agent", "cli", "toon", "decisions", "review"],
  "scripts": {
    "build": "tsc",
    "build:skill": "tsc && node dist/skill.js",
    "prepack": "tsc",
    "test": "tsc && node --test --test-global-setup=test/temp-folder.mjs"
  },
  "dependencies": { "@toon-format/toon": "2.3.1", "axi-sdk-js": "0.1.13" },
  "devDependencies": { "@types/node": "^26.6.5", "typescript": "^7.0.2" }
}
